{
  "name": "rpg-prop-kit",
  "version": "0.2.0",
  "description": "Props de UI para RPG de mesa — CRT retrô e analógicos (pergaminho, lacre, cartaz, placa, dataslate).",
  "type": "module",
  "license": "MIT",
  "author": "Felipe Lippelt",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flippelt/rpg-prop-kit.git"
  },
  "homepage": "https://github.com/flippelt/rpg-prop-kit#readme",
  "bugs": "https://github.com/flippelt/rpg-prop-kit/issues",
  "keywords": [
    "react",
    "crt",
    "retro",
    "terminal",
    "ttrpg",
    "rpg",
    "tabletop",
    "parchment",
    "handout",
    "components"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/rpg-prop-kit.umd.cjs",
  "module": "./dist/rpg-prop-kit.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/rpg-prop-kit.js",
      "require": "./dist/rpg-prop-kit.umd.cjs"
    },
    "./styles.css": "./dist/rpg-prop-kit.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm test && npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript/typescript6": "^6.0.2",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^30.0.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^7.0.2",
    "vite": "^8.0.16",
    "vite-plugin-dts": "^5.0.2",
    "vitest": "^4.1.8"
  }
}
